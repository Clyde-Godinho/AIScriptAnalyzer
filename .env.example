# ---------------------------------------------------------------------------
# Repositories to ingest
# ---------------------------------------------------------------------------
DOCS_WIKI_URL=https://github.com/linux-on-ibm-z/docs.wiki.git
DOCS_REPO_URL=https://github.com/linux-on-ibm-z/docs.git
SCRIPTS_REPO_URL=https://github.com/linux-on-ibm-z/scripts.git
WORK_DIR=data/repos
GIT_DEPTH=1
GIT_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Vector store (deterministic metadata matching on package_name + distro)
# ---------------------------------------------------------------------------
VECTOR_BACKEND=chroma           # chroma | qdrant
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=s390x_doc_script
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=s390x_doc_script

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# "hash" is a dependency-free deterministic embedder (dev / offline / tests).
# "openai" uses any OpenAI-compatible /v1/embeddings endpoint (OpenAI, vLLM, TEI).
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# ---------------------------------------------------------------------------
# LLM (structured output enforced by Instructor)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai             # openai | anthropic
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+pysqlite:///./data/analyzer.db

# ---------------------------------------------------------------------------
# RAG / chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=1400
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=8
MAX_CONTEXT_CHARS=24000

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_TOKEN=                      # optional bearer token; empty disables auth
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
